{% extends 'base.html.twig' %}

{% block title %}{{ product.id is defined ? 'Modifier' : 'Nouveau' }} produit{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>{{ product.id is defined ? 'Modifier le produit' : 'Ajouter un produit' }}</h1>

    {% include 'layouts/_flash_message.html.twig' %}

    {{ include('product/_form.html.twig') }}

    <a href="{{ path('app_product_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
</div>
{% endblock %}