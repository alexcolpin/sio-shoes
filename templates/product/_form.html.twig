{{ form_start(form) }}
    <div class="mb-3">
        <label class="form-label">Nom du produit</label>
        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Nom du produit'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="mb-3">
        <label class="form-label">Prix</label>
        {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.price) }}
    </div>

    {# Sous-catégories (ManyToMany) #}
    <div class="mb-3">
        <label class="form-label">Sous-catégories</label>
        {{ form_widget(form.subCategories, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.subCategories) }}
    </div>

    <button class="btn btn-success">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}